# ==============================================================================
# INE Product Price Tracker - Environment Variables
# Copy to backend/.env to configure your deployment
# ==============================================================================

# Server Port
PORT=5001

# Mock Store Target URL
MOCK_STORE_URL=https://demo.inelabteamdev.com

# Supabase Credentials (PostgreSQL Cloud)
# Obtain these from https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Cron Job Webhook Security Secret
# Use this Bearer token when setting up your cron trigger on https://cron-job.org
CRON_SECRET=ine_cron_secret_key_2026

# Optional Headed Browser Flag (set to true on local desktop to watch browser execution)
ENABLE_HEADED_BROWSER=false
